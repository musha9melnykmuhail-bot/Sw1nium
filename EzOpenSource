local Movement = S.MovementState

local function GetHumanoid()
    local char = LocalPlayer.Character
    return char and char:FindFirstChildOfClass("Humanoid"), char
end

local function StopFly()
    Movement.flyEnabled = false
    if Movement._flyBV then Movement._flyBV:Destroy(); Movement._flyBV = nil end
    if Movement._flyBG then Movement._flyBG:Destroy(); Movement._flyBG = nil end
    local hum = GetHumanoid()
    if hum then pcall(function() hum.PlatformStand = false end) end
end

local function StartFly()
    local hum, char = GetHumanoid()
    if not hum or not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    Movement.flyEnabled = true
    hum.PlatformStand = true
    local bv = Instance.new("BodyVelocity")
    bv.Name = "Sw1nium_FlyBV"
    bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
    bv.Velocity = Vector3.zero
    bv.Parent = hrp
    local bg = Instance.new("BodyGyro")
    bg.Name = "Sw1nium_FlyBG"
    bg.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
    bg.P = 1000
    bg.D = 50
    bg.CFrame = hrp.CFrame
    bg.Parent = hrp
    Movement._flyBV = bv
    Movement._flyBG = bg
end

RunService.RenderStepped:Connect(function()
    if not Movement.flyEnabled then return end
    local hum, char = GetHumanoid()
    if not hum or not char then StopFly(); return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp or not Movement._flyBV or not Movement._flyBG then return end
    local cam = workspace.CurrentCamera
    if not cam then return end
    local move = Vector3.zero
    if UserInputService:IsKeyDown(Enum.KeyCode.W) then move = move + cam.CFrame.LookVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) then move = move - cam.CFrame.LookVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then move = move - cam.CFrame.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then move = move + cam.CFrame.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then move = move + Vector3.new(0,1,0) end
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then move = move - Vector3.new(0,1,0) end
    if move.Magnitude > 0 then move = move.Unit end
    Movement._flyBV.Velocity = move * Movement.flySpeed
    Movement._flyBG.CFrame = CFrame.new(hrp.Position, hrp.Position + cam.CFrame.LookVector)
end)

RunService.Heartbeat:Connect(function()
    if not Movement.speedhack then return end
    local hum = GetHumanoid()
    if hum then pcall(function() hum.WalkSpeed = Movement.speedValue end) end
end)

UserInputService.InputBegan:Connect(function(input, gP)
    if gP then return end
    if input.KeyCode == Enum.KeyCode.LeftShift then
        Movement.sprintKey = true
        if Movement.autoSprint then
            local hum = GetHumanoid()
            if hum then pcall(function() hum.WalkSpeed = math.max(hum.WalkSpeed, Movement.speedValue) end) end
        end
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.LeftShift then
        Movement.sprintKey = false
        if Movement.autoSprint and not Movement.speedhack then
            local hum = GetHumanoid()
            if hum then pcall(function() hum.WalkSpeed = Movement._defaultWalkSpeed end) end
        end
    end
end)

local function ApplyMovementOnCharacter(char)
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    if Movement.speedhack then hum.WalkSpeed = Movement.speedValue end
    if Movement.jumpPower then hum.UseJumpPower = true; hum.JumpPower = Movement.jumpPower end
    if Movement.infiniteJump then
        if Movement._jumpConn then Movement._jumpConn:Disconnect() end
        Movement._jumpConn = UserInputService.JumpRequest:Connect(function()
            if Movement.infiniteJump and hum then
                pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
            end
        end)
    end
    if Movement.noclip then
        if Movement._noclipConn then Movement._noclipConn:Disconnect() end
        Movement._noclipConn = RunService.Stepped:Connect(function()
            if not Movement.noclip then return end
            local c = LocalPlayer.Character
            if c then
                for _, p in ipairs(c:GetDescendants()) do
                    if p:IsA("BasePart") and p.CanCollide then p.CanCollide = false end
                end
            end
        end)
    end
    if Movement.bunnyhop then
        if Movement._bhopConn then Movement._bhopConn:Disconnect() end
        Movement._bhopConn = RunService.Heartbeat:Connect(function()
            if not Movement.bunnyhop then return end
            local h = GetHumanoid()
            if h and h.MoveDirection.Magnitude > 0 then
                pcall(function() h:ChangeState(Enum.HumanoidStateType.Jumping) end)
            end
        end)
    end
    if Movement.flyEnabled then StartFly() end
end

LocalPlayer.CharacterAdded:Connect(function(char)
    task.wait(0.5)
    ApplyMovementOnCharacter(char)
end)
if LocalPlayer.Character then
    task.spawn(function() task.wait(0.5); ApplyMovementOnCharacter(LocalPlayer.Character) end)
end

