    local bindBtn = Instance.new("TextButton", wrap)
    bindBtn.Size = UDim2.new(0, 52, 0, 18)
    bindBtn.Position = UDim2.new(1, -52, 0.5, -9)
    bindBtn.BackgroundColor3 = C_BG
    bindBtn.Font = Enum.Font.BuilderSansBold
    bindBtn.Text = "[NONE]"
    bindBtn.TextColor3 = Color3.fromRGB(160, 160, 185)
    bindBtn.TextSize = 9
    Instance.new("UICorner", bindBtn).CornerRadius = UDim.new(0, 4)
    local bSt2 = Instance.new("UIStroke", bindBtn)
    bSt2.Color = C_BORDER

    local state = defaultState
    local boundKey = nil
    local locked = false

    local kbRow = Instance.new("Frame", kbListFrame)
    kbRow.Size = UDim2.new(1, 0, 0, 16)
    kbRow.BackgroundTransparency = 1
    kbRow.Visible = false

    local kbTextLabel = Instance.new("TextLabel", kbRow)
    kbTextLabel.Size = UDim2.new(0.7, 0, 1, 0)
    kbTextLabel.Position = UDim2.new(0, 8, 0, 0)
    kbTextLabel.BackgroundTransparency = 1
    kbTextLabel.Font = Enum.Font.BuilderSansMedium
    kbTextLabel.Text = text
    kbTextLabel.TextColor3 = C_MUTED
    kbTextLabel.TextSize = 10
    kbTextLabel.TextXAlignment = Enum.TextXAlignment.Left

    local kbStatusLabel = Instance.new("TextLabel", kbRow)
    kbStatusLabel.Size = UDim2.new(0.3, -8, 1, 0)
    kbStatusLabel.Position = UDim2.new(0.7, 0, 0, 0)
    kbStatusLabel.BackgroundTransparency = 1
    kbStatusLabel.Font = Enum.Font.BuilderSansBold
    kbStatusLabel.Text = "[NONE]"
    kbStatusLabel.TextColor3 = C_ACCENT
    kbStatusLabel.TextSize = 9
    kbStatusLabel.TextXAlignment = Enum.TextXAlignment.Right

    ActiveBinds[text] = { Frame = kbRow, KeyLabel = kbStatusLabel }

    local function updateVisuals()
        local tw = TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
        if locked then
            TweenService:Create(toggleBg, tw, {BackgroundColor3 = C_LOCK_BG}):Play()
            TweenService:Create(tStroke, tw, {Color = C_LOCK_STROKE}):Play()
            TweenService:Create(thumb, tw, {BackgroundColor3 = Color3.fromRGB(120, 110, 60)}):Play()
            TweenService:Create(label, tw, {TextColor3 = C_LOCK_YELLOW}):Play()
            kbRow.Visible = false
        else
            TweenService:Create(toggleBg, tw, {BackgroundColor3 = state and C_ACCENT or C_TOGGLE_OFF}):Play()
            TweenService:Create(tStroke, tw, {Color = state and C_ACCENT or C_BORDER}):Play()
            TweenService:Create(thumb, tw, {
                Position = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7),
                BackgroundColor3 = state and C_BG or C_MUTED,
            }):Play()
            TweenService:Create(label, tw, {TextColor3 = state and C_ACCENT or C_MUTED}):Play()
            kbRow.Visible = (state and boundKey ~= nil)
            if boundKey then
                kbStatusLabel.Text = "[" .. boundKey.Name .. "]"
            else
                kbStatusLabel.Text = "[NONE]"
            end
        end
        UpdateKeybindContainerHeight()
    end

    local function update(newState, silent)
        if locked then return end
        state = newState
        updateVisuals()
        if not silent then ShowNotification(text, state) end
        if callback then callback(state) end
    end

    mainBtn.MouseButton1Click:Connect(function() update(not state) end)
    bindBtn.MouseButton1Click:Connect(function()
        if locked then return end
        bindBtn.Text = "..."
        bindBtn.TextColor3 = Color3.fromRGB(255, 200, 100)
        local conn
        conn = UserInputService.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Keyboard then
                if input.KeyCode == Enum.KeyCode.Escape then
                    boundKey = nil
                    bindBtn.Text = "[NONE]"
                else
                    boundKey = input.KeyCode
                    bindBtn.Text = "[" .. input.KeyCode.Name .. "]"
                end
                bindBtn.TextColor3 = Color3.fromRGB(160, 160, 185)
                conn:Disconnect()
                updateVisuals()
            end
        end)
    end)
    UserInputService.InputBegan:Connect(function(input, gP)
        if not gP and boundKey and input.KeyCode == boundKey and not locked then
            update(not state)
        end
    end)
    table.insert(S.RegisteredToggles, function() if state then update(false, true) end end)

    local wrapper = {
        Set = function(v, silent) update(v, silent) end,
        Get = function() return state end,
        ForceOff = function()
            if state then state = false; updateVisuals(); if callback then callback(false) end end
        end,
        SetLocked = function(v)
            locked = v
            if locked and state then
                state = false
                if callback then callback(false) end
            end
            updateVisuals()
        end,
        Group = group,
    }
    if group then table.insert(S.SafeModeToggles, wrapper) end
    return wrapper
end

