local currentActiveTab = nil
local function SwitchTab(targetName)
    currentActiveTab = targetName
    for name, btnData in pairs(TabButtons) do
        local isCurrent = (name == targetName)
        local tw = TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
        TweenService:Create(btnData.Pill, tw, {BackgroundTransparency = isCurrent and 0 or 1}):Play()
        TweenService:Create(btnData.Icon, tw, {ImageColor3 = isCurrent and C_ACCENT or C_MUTED}):Play()
        TweenService:Create(btnData.Button, tw, {TextColor3 = isCurrent and C_ACCENT or C_MUTED}):Play()
        TweenService:Create(btnData.Frame, tw, {BackgroundTransparency = isCurrent and 0 or 1}):Play()
        btnData.Button.Font = isCurrent and Enum.Font.BuilderSansBold or Enum.Font.BuilderSansMedium
    end
    for name, data in pairs(Pages) do
        if name == targetName then
            data.Page.Visible = true
            data.Canvas.GroupTransparency = 1
            data.Canvas.Position = UDim2.new(0, 10, 0, 0)
            TweenService:Create(data.Canvas, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                GroupTransparency = 0,
                Position = UDim2.new(0, 0, 0, 0),
