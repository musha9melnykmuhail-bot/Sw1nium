task.spawn(function()
    local scripts = {
        { name = "Sw1nium", url = "https://raw.githubusercontent.com/musha9melnykmuhail-bot/LoadOBF/refs/heads/main/Sw1nium", delay = 3.5 },
        { name = "WatermarkOBF", url = "https://raw.githubusercontent.com/musha9melnykmuhail-bot/LoadOBF/refs/heads/main/WatermarkOBF", delay = 0 },
    }
    local function LoadScript(url, name)
        local ok, code = pcall(function() return game:HttpGet(url) end)
        if not ok or not code then
            ShowNotification("Failed: " .. name, "Danger")
            return
        end
        local fn
        if loadstring then
            local ok2, result = pcall(loadstring, code)
            if ok2 then fn = result end
        end
        if not fn then
            ShowNotification("Compile fail: " .. name, "Danger")
            return
        end
        local ok3 = pcall(fn)
        if not ok3 then
            ShowNotification("Runtime fail: " .. name, "Danger")
        end
    end
    for _, scr in ipairs(scripts) do
        if scr.delay and scr.delay > 0 then
            task.wait(scr.delay)
        end
        LoadScript(scr.url, scr.name)
    end
end)
