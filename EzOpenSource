end

local function ClearChams(obj)
    if not obj then return end
    for _, key in ipairs({"ChamsFill", "ChamsOutline", "ChamsWire", "ChamsGlow", "ChamsPulse"}) do
        local g = obj[key]
        if g then
            for i, inst in pairs(g) do
                pcall(function() inst:Destroy() end)
                g[i] = nil
            end
            obj[key] = nil
        end
    end
end

local function RemoveESPForPlayer(plr)
    local obj = ESP.Objects[plr]
    if not obj then return end
    ClearChams(obj)
    for _, v in pairs(obj) do
        if type(v) == "table" then
            for _, vv in pairs(v) do
                pcall(function() vv:Remove() end)
                pcall(function() vv:Destroy() end)
            end
        else
            pcall(function() v:Remove() end)
            pcall(function() v:Destroy() end)
        end
    end
    ESP.Objects[plr] = nil
end

function ESP.FullCleanup()
    for _, obj in pairs(ESP.Objects) do
        HideAllESP(obj)
        ClearChams(obj)
    end
    for plr in pairs(ESP.Objects) do
        RemoveESPForPlayer(plr)
    end
    ESP.Objects = {}
end

