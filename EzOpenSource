    local dx = MainFrame.Position.X.Offset - dragState.target.X.Offset
    local dy = MainFrame.Position.Y.Offset - dragState.target.Y.Offset
    if dragState.active or (dx * dx + dy * dy) > 0.25 then
        MainFrame.Position = MainFrame.Position:Lerp(dragState.target, math.clamp(dt * 22, 0, 1))
    end
end)

local uiState = { visible = true, animating = false }
local function ToggleUI()
    if uiState.animating then return end
    uiState.animating = true
    uiState.visible = not uiState.visible
    if uiState.visible then
        MainFrame.Visible = true
        ScreenBlur.Enabled = true
        DimOverlay.Visible = true
        TweenService:Create(DimOverlay, TweenInfo.new(0.35), {BackgroundTransparency = 0.75}):Play()
        TweenService:Create(ScreenBlur, TweenInfo.new(0.35), {Size = 14}):Play()
        local t = TweenService:Create(MainFrame, TweenInfo.new(0.35, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {GroupTransparency = 0, Size = UDim2.new(0, 720, 0, 540)})
        t:Play()
        t.Completed:Connect(function() uiState.animating = false end)
    else
        TweenService:Create(DimOverlay, TweenInfo.new(0.3), {BackgroundTransparency = 1}):Play()
        TweenService:Create(ScreenBlur, TweenInfo.new(0.3), {Size = 0}):Play()
        local t = TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Exponential, Enum.EasingDirection.In), {GroupTransparency = 1, Size = UDim2.new(0, 690, 0, 515)})
        t:Play()
        t.Completed:Connect(function()
            MainFrame.Visible = false
            DimOverlay.Visible = false
            ScreenBlur.Enabled = false
            uiState.animating = false
        end)
    end
end

UserInputService.InputBegan:Connect(function(input, gP)
    if gP then return end
    if input.KeyCode == Enum.KeyCode.RightShift then
        ToggleUI()
        pcall(function()
            if VirtualInputManager and VirtualInputManager.SendKeyEvent then
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.O, false, game)
                task.wait(0.05)
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.O, false, game)
            end
        end)
    end
end)

