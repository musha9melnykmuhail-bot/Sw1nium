        if M._jumpConn then M._jumpConn:Disconnect(); M._jumpConn = nil end
        if M._bhopConn then M._bhopConn:Disconnect(); M._bhopConn = nil end
        if M._noclipConn then M._noclipConn:Disconnect(); M._noclipConn = nil end
