--============================================================
local Troll = S.TrollState

local function StopSpinbot()
    if Troll.spinbotConn then Troll.spinbotConn:Disconnect(); Troll.spinbotConn = nil end
end
local function StartSpinbot()
    StopSpinbot()
    Troll.spinbotConn = RunService.RenderStepped:Connect(function(dt)
        if not Troll.spinbot then return end
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(Troll.spinSpeed * dt * 60), 0)
        end
    end)
end

local function FlingTarget(targetPlr)
    if not targetPlr then return end
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local targetRoot = targetPlr.Character and targetPlr.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot or not targetRoot then return end
    local dir = (targetRoot.Position - myRoot.Position).Unit
    local bv = Instance.new("BodyVelocity")
    bv.Velocity = dir * 500 + Vector3.new(0, 200, 0)
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bv.Parent = targetRoot
    task.delay(0.3, function() bv:Destroy() end)
end

local function SendChatMessage(text)
    pcall(function()
        local rs = game:GetService("ReplicatedStorage")
        if rs:FindFirstChild("DefaultChatSystemChatEvents") then
            rs.DefaultChatSystemChatEvents.SayMessageRequest:FireServer(text, "All")
        else
            local chat = game:GetService("TextChatService")
            local ch = chat.TextChannels and chat.TextChannels:FindFirstChild("RBXGeneral")
            if ch then ch:SendAsync(text) end
        end
    end)
end

local function StopChatSpam()
    if Troll.spamConn then Troll.spamConn:Disconnect(); Troll.spamConn = nil end
end
local function StartChatSpam()
    StopChatSpam()
    Troll.spamConn = task.spawn(function()
        while Troll.chatSpam do
            SendChatMessage(Troll.chatText)
            task.wait(Troll.spamInterval)
        end
    end)
end

