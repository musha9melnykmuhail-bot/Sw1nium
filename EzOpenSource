-- COMBAT MODULE
--============================================================
local CM = {
    killAll = false, killAllConn = nil, killAllRange = 10, killAllDelay = 0.1, _lastKill = 0,
    autoShoot = false, autoShootConn = nil, autoShootDelay = 0.1, _lastShot = 0,
    autoGrabGun = false, autoGrabGunConn = nil,
    autoGrabKnife = false, autoGrabKnifeConn = nil,
    autoStab = false, autoStabConn = nil, autoStabRange = 25,
    autoTeleKill = false, autoTeleKillConn = nil,
    silentAim = false, silentAimConn = nil,
    fovCircle = true, fovRadius = 120, fovColor = Color3.new(1,1,1), _fovDrawing = nil,
    aimAssist = false, aimAssistConn = nil, aimSmoothness = 5,
    autoReload = false, autoReloadConn = nil,
    hitbox = "Head", visibleOnly = true, maxDistance = 500,
}

local function CM_GetMyRole() return DetectRole(LocalPlayer) end

local function CM_GetTool(name)
    local char = LocalPlayer.Character
    if char then
        for _, t in ipairs(char:GetChildren()) do
            if t:IsA("Tool") and t.Name == name then return t end
        end
    end
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then
        for _, t in ipairs(bp:GetChildren()) do
            if t:IsA("Tool") and t.Name == name then return t end
        end
    end
    return nil
end

local function CM_Equip(tool)
    local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if hum and tool then pcall(function() hum:EquipTool(tool) end) end
end

local function CM_Hitbox(plr)
    local char = plr.Character
    if not char then return nil end
    local name = CM.hitbox
    if name == "Random" then
        local opts = {"Head", "UpperTorso", "HumanoidRootPart"}
        name = opts[math.random(1, #opts)]
    end
    return char:FindFirstChild(name) or char:FindFirstChild("HumanoidRootPart")
end

local function CM_Visible(target)
    if not CM.visibleOnly then return true end
    local cam = workspace.CurrentCamera
    local myChar = LocalPlayer.Character
    if not cam or not myChar then return false end
    local part = CM_Hitbox(target)
    if not part then return false end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {myChar, target.Character, cam}
    local result = workspace:Raycast(cam.CFrame.Position, part.Position - cam.CFrame.Position, params)
    return result == nil
end

local function CM_NearestInFov(filter)
    local cam = workspace.CurrentCamera
    if not cam then return nil end
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    local closest, closestDist = nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local char = plr.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local role = DetectRole(plr)
                local match = false
                if filter == "enemy" then match = (role ~= "Murderer" and role ~= "Unknown")
                elseif filter == "murderer" then match = (role == "Murderer")
                elseif filter == "any" then match = true end
                if match then
                    local d = (hrp.Position - myRoot.Position).Magnitude
                    if d <= CM.maxDistance then
                        local sp, on = cam:WorldToViewportPoint(hrp.Position)
                        if on then
                            local center = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)
                            local sd = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                            if sd <= CM.fovRadius and sd < closestDist then
                                if CM_Visible(plr) then closest, closestDist = plr, sd end
                            end
                        end
                    end
                end
            end
        end
    end
    return closest
end

local function CM_NearestByDist(filter, maxD)
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    local closest, closestDist = nil, maxD or math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local char = plr.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local role = DetectRole(plr)
                local match = false
                if filter == "enemy" then match = (role ~= "Murderer" and role ~= "Unknown")
                elseif filter == "murderer" then match = (role == "Murderer")
                elseif filter == "any" then match = true end
                if match then
                    local d = (hrp.Position - myRoot.Position).Magnitude
                    if d <= closestDist then closest, closestDist = plr, d end
                end
            end
        end
    end
    return closest
end

local function CM_StopKillAll() if CM.killAllConn then CM.killAllConn:Disconnect(); CM.killAllConn = nil end end
local function CM_StartKillAll()
    CM_StopKillAll()
    CM.killAllConn = RunService.Heartbeat:Connect(function()
        if not CM.killAll then return end
        if CM_GetMyRole() ~= "Murderer" then return end
        local now = tick()
        if now - CM._lastKill < CM.killAllDelay then return end
        local myChar = LocalPlayer.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myRoot then return end
        local knife = CM_GetTool("Knife")
        if not knife then return end
        CM_Equip(knife)
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then
                local role = DetectRole(plr)
                if role ~= "Murderer" and role ~= "Unknown" then
                    local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
                    if hrp and (hrp.Position - myRoot.Position).Magnitude <= CM.killAllRange then
                        CM._lastKill = now
                        pcall(function() knife:Activate() end)
                        for _, part in ipairs(plr.Character:GetDescendants()) do
                            if part:IsA("BasePart") then
                                pcall(function()
                                    if firetouchinterest then
                                        firetouchinterest(part, part, 0)
                                        firetouchinterest(part, part, 1)
                                    end
                                end)
                            end
                        end
                    end
                end
            end
        end
    end)
end

local function CM_StopAutoShoot() if CM.autoShootConn then CM.autoShootConn:Disconnect(); CM.autoShootConn = nil end end
local function CM_StartAutoShoot()
    CM_StopAutoShoot()
    CM.autoShootConn = RunService.Heartbeat:Connect(function()
        if not CM.autoShoot then return end
        if CM_GetMyRole() ~= "Sheriff" then return end
        local now = tick()
        if now - CM._lastShot < CM.autoShootDelay then return end
        local gun = CM_GetTool("Gun") or CM_GetTool("Revolver")
        if not gun then return end
        CM_Equip(gun)
        local target = CM_NearestInFov("murderer")
        if target then
            CM._lastShot = now
            local part = CM_Hitbox(target)
            pcall(function() gun:Activate() end)
            pcall(function()
                if gun:FindFirstChild("Fire") and gun.Fire:IsA("RemoteEvent") then
                    gun.Fire:FireServer(part)
