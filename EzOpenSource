local ConfigMgr = {}
ConfigMgr.Folder = "sw1nium_configs"
ConfigMgr.Extension = ".json"

local function ensureFolder()
    if writefile and makefolder and not (isfolder and isfolder(ConfigMgr.Folder)) then
        pcall(function() makefolder(ConfigMgr.Folder) end)
    end
end

function ConfigMgr.List()
    local out = {}
    if not listfiles or not isfolder or not isfolder(ConfigMgr.Folder) then return out end
    local ok, files = pcall(function() return listfiles(ConfigMgr.Folder) end)
    if not ok or not files then return out end
    for _, f in ipairs(files) do
        local name = f:match("([^/\\]+)$") or f
        if name:sub(-#ConfigMgr.Extension) == ConfigMgr.Extension then
            table.insert(out, name:sub(1, #name - #ConfigMgr.Extension))
        end
    end
    return out
end

