            chatSpam = Troll.chatSpam, chatText = Troll.chatText, spamInterval = Troll.spamInterval,
        },
        SafeMode = S.SafeMode,
        Meta = { Version = "2.0", SavedAt = os.time() },
    }
    local ok = pcall(function()
        writefile(ConfigMgr.Folder .. "/" .. name .. ConfigMgr.Extension, HttpService:JSONEncode(data))
    end)
    if ok then ShowNotification("Saved: " .. name, true) else ShowNotification("Save failed", false) end
    return ok
end

local function parseColor(s, fallback)
    if type(s) == "string" then
        local r, g, b = s:match("([%d%.]+),([%d%.]+),([%d%.]+)")
        if r and g and b then return Color3.new(tonumber(r), tonumber(g), tonumber(b)) end
    end
    return fallback or Color3.new(1,1,1)
end

function ConfigMgr.Load(name)
    if not readfile then ShowNotification("No readfile", false); return false end
    local path = ConfigMgr.Folder .. "/" .. name .. ConfigMgr.Extension
    if not (isfile and isfile(path)) then ShowNotification("Not found: " .. name, false); return false end
    local ok, data = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
    if not ok or not data then ShowNotification("Load failed", false); return false end

    if data.ESP then
        local E = data.ESP
        ESP.Enabled = E.Enabled or ESP.Enabled
        ESP.Boxes = E.Boxes or ESP.Boxes
        ESP.BoxType = E.BoxType or ESP.BoxType
        ESP.BoxThickness = E.BoxThickness or ESP.BoxThickness
        ESP.Names = E.Names or ESP.Names
        ESP.NameSize = E.NameSize or ESP.NameSize
        ESP.ShowRole = E.ShowRole ~= nil and E.ShowRole or ESP.ShowRole
        ESP.Distance = E.Distance or ESP.Distance
        if E.DistanceColor then ESP.DistanceColor = parseColor(E.DistanceColor, ESP.DistanceColor) end
        ESP.Health = E.Health or ESP.Health
        if E.HealthColor then ESP.HealthColor = parseColor(E.HealthColor, ESP.HealthColor) end
        ESP.HealthText = E.HealthText or ESP.HealthText
        ESP.Tracers = E.Tracers or ESP.Tracers
        ESP.TracerOrigin = E.TracerOrigin or ESP.TracerOrigin
        ESP.Chams = E.Chams or ESP.Chams
        ESP.ChamsType = E.ChamsType or ESP.ChamsType
        ESP.ChamsTransparency = E.ChamsTransparency or ESP.ChamsTransparency
        ESP.Skeleton = E.Skeleton or ESP.Skeleton
        if E.SkeletonColor then ESP.SkeletonColor = parseColor(E.SkeletonColor, ESP.SkeletonColor) end
        ESP.SkeletonThickness = E.SkeletonThickness or ESP.SkeletonThickness
        ESP.MaxDistance = E.MaxDistance or ESP.MaxDistance
        ESP.TeamCheck = E.TeamCheck or ESP.TeamCheck
        ESP.IgnoreDead = E.IgnoreDead ~= nil and E.IgnoreDead or ESP.IgnoreDead
        ESP.UseRoleColors = E.UseRoleColors ~= nil and E.UseRoleColors or ESP.UseRoleColors
        if E.Arrows ~= nil then ESP.Arrows = E.Arrows end
        if E.ArrowRadius then ESP.ArrowRadius = E.ArrowRadius end
        if E.ArrowSize then ESP.ArrowSize = E.ArrowSize end
        if E.ArrowColor then ESP.ArrowColor = parseColor(E.ArrowColor, ESP.ArrowColor) end
    end

    if data.Combat then
        local C = data.Combat
        CM.killAll = C.killAll or CM.killAll
        CM.killAllRange = C.killAllRange or CM.killAllRange
        CM.killAllDelay = C.killAllDelay or CM.killAllDelay
        CM.autoShoot = C.autoShoot or CM.autoShoot
        CM.autoShootDelay = C.autoShootDelay or CM.autoShootDelay
        CM.autoGrabGun = C.autoGrabGun or CM.autoGrabGun
        CM.autoGrabKnife = C.autoGrabKnife or CM.autoGrabKnife
        CM.autoStab = C.autoStab or CM.autoStab
        CM.autoStabRange = C.autoStabRange or CM.autoStabRange
        CM.autoTeleKill = C.autoTeleKill or CM.autoTeleKill
        CM.silentAim = C.silentAim or CM.silentAim
        CM.fovCircle = C.fovCircle ~= nil and C.fovCircle or CM.fovCircle
        CM.fovRadius = C.fovRadius or CM.fovRadius
        if C.fovColor then CM.fovColor = parseColor(C.fovColor, CM.fovColor) end
        CM.aimAssist = C.aimAssist or CM.aimAssist
        CM.aimSmoothness = C.aimSmoothness or CM.aimSmoothness
        CM.autoReload = C.autoReload or CM.autoReload
        CM.hitbox = C.hitbox or CM.hitbox
        CM.visibleOnly = C.visibleOnly ~= nil and C.visibleOnly or CM.visibleOnly
        CM.maxDistance = C.maxDistance or CM.maxDistance

        if CM.killAll then CM_StartKillAll() else CM_StopKillAll() end
        if CM.autoShoot then CM_StartAutoShoot() else CM_StopAutoShoot() end
        if CM.autoGrabGun then CM_StartAutoGrabGun() else CM_StopAutoGrabGun() end
        if CM.autoGrabKnife then CM_StartAutoGrabKnife() else CM_StopAutoGrabKnife() end
        if CM.autoStab then CM_StartAutoStab() else CM_StopAutoStab() end
        if CM.autoTeleKill then CM_StartAutoTeleKill() else CM_StopAutoTeleKill() end
        if CM.silentAim then CM_StartSilentAim() else CM_StopSilentAim() end
        if CM.aimAssist then CM_StartAimAssist() else CM_StopAimAssist() end
        if CM.autoReload then CM_StartAutoReload() else CM_StopAutoReload() end
    end

    if data.Movement then
        local M = data.Movement
        Movement.speedhack = M.speedhack or Movement.speedhack
        Movement.speedValue = M.speedValue or Movement.speedValue
        Movement.infiniteJump = M.infiniteJump or Movement.infiniteJump
        Movement.bunnyhop = M.bunnyhop or Movement.bunnyhop
        Movement.noclip = M.noclip or Movement.noclip
        Movement.flySpeed = M.flySpeed or Movement.flySpeed
        Movement.jumpPower = M.jumpPower or Movement.jumpPower
        if M.flyEnabled and not Movement.flyEnabled then StartFly() end
        if not M.flyEnabled and Movement.flyEnabled then StopFly() end
    end

    if data.Troll then
        local T = data.Troll
        Troll.spinbot = T.spinbot or Troll.spinbot
        Troll.spinSpeed = T.spinSpeed or Troll.spinSpeed
        Troll.chatSpam = T.chatSpam or Troll.chatSpam
        Troll.chatText = T.chatText or Troll.chatText
        Troll.spamInterval = T.spamInterval or Troll.spamInterval
    end

    if data.SafeMode ~= nil then
        SetSafeMode(data.SafeMode)
    end

    ShowNotification("Loaded: " .. name, true)
    return true
end

function ConfigMgr.Delete(name)
    if not delfile then ShowNotification("No delfile", false); return false end
    local path = ConfigMgr.Folder .. "/" .. name .. ConfigMgr.Extension
    if not (isfile and isfile(path)) then ShowNotification("Not found", false); return false end
    local ok = pcall(function() delfile(path) end)
    if ok then ShowNotification("Deleted: " .. name, false) else ShowNotification("Delete failed", false) end
    return ok
end

