        if s then
            M._jumpConn = UserInputService.JumpRequest:Connect(function()
                if M.infiniteJump then
                    local hum = GetHumanoid()
                    if hum then pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end) end
                end
            end)
        end
