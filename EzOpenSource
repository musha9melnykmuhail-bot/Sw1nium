    listStroke.Color = C_BORDER
    local listScroll = Instance.new("ScrollingFrame", listFrame)
    listScroll.Size = UDim2.new(1, -8, 1, -8)
    listScroll.Position = UDim2.new(0, 4, 0, 4)
    listScroll.BackgroundTransparency = 1
    listScroll.ScrollBarThickness = 2
    listScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
    listScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
    local listLayout = Instance.new("UIListLayout", listScroll)
    listLayout.Padding = UDim.new(0, 4)

    local selectedName = nil

    local function refreshConfigList()
        for _, ch in ipairs(listScroll:GetChildren()) do
            if ch:IsA("TextButton") then ch:Destroy() end
        end
        local names = ConfigMgr.List()
        if #names == 0 then
            local emptyLbl = Instance.new("TextLabel", listScroll)
            emptyLbl.Size = UDim2.new(1, 0, 0, 20)
            emptyLbl.BackgroundTransparency = 1
            emptyLbl.Font = Enum.Font.BuilderSansMedium
            emptyLbl.Text = "No configs yet. Create one below."
            emptyLbl.TextColor3 = C_MUTED
            emptyLbl.TextSize = 11
            emptyLbl.TextXAlignment = Enum.TextXAlignment.Left
            return
        end
        for _, n in ipairs(names) do
            local row = Instance.new("TextButton", listScroll)
            row.Size = UDim2.new(1, 0, 0, 20)
            row.BackgroundColor3 = C_CARD
            row.BackgroundTransparency = 0.4
            row.Text = "  " .. n
            row.TextColor3 = C_ACCENT
            row.Font = Enum.Font.BuilderSansMedium
            row.TextSize = 11
            row.TextXAlignment = Enum.TextXAlignment.Left
            Instance.new("UICorner", row).CornerRadius = UDim.new(0, 4)
            row.MouseButton1Click:Connect(function()
                selectedName = n
                if cfgNameBox then cfgNameBox.Text = n end
                ShowNotification("Selected: " .. n, "Info")
            end)
        end
    end
    refreshConfigList()

    F.CreateButton(cfgCard, "Save / Overwrite", function()
        local name = (cfgNameBox and cfgNameBox.Text ~= "") and cfgNameBox.Text or selectedName or "default"
        if ConfigMgr.Save(name) then
            selectedName = name
            refreshConfigList()
        end
    end)
    F.CreateButton(cfgCard, "Load Selected", function()
        local name = (cfgNameBox and cfgNameBox.Text ~= "") and cfgNameBox.Text or selectedName
        if not name then ShowNotification("No config selected", false); return end
        ConfigMgr.Load(name)
    end)
    F.CreateButton(cfgCard, "Delete Selected", function()
        local name = (cfgNameBox and cfgNameBox.Text ~= "") and cfgNameBox.Text or selectedName
        if not name then ShowNotification("No config selected", false); return end
        if ConfigMgr.Delete(name) then
            if selectedName == name then selectedName = nil end
            refreshConfigList()
        end
    end)
    F.CreateButton(cfgCard, "Refresh List", function()
        refreshConfigList()
        ShowNotification("Refreshed", true)
    end)
    F.CreateButton(cfgCard, "Print Folder Path", function()
        print("[Sw1nium] Config folder:", ConfigMgr.Folder)
        ShowNotification("Printed to console", "Info")
    end)

    local menu = F.CreateSection(c2, "Menu Controls", "rbxassetid://11956055886")
    F.CreateButton(menu, "Unload Script", function()
        ConfirmModal.Visible = true
        ConfirmModal.BackgroundTransparency = 0.5
