    Root.Size = UDim2.new(0, 320, 0, 540)
    Root.Position = UDim2.new(0, 0, 0, 0)
    Root.BackgroundColor3 = C_BG
    Root.BorderSizePixel = 0
    Root.Visible = false
    Root.Parent = PreviewGui
    Instance.new("UICorner", Root).CornerRadius = UDim.new(0, 12)
    local rootStroke = Instance.new("UIStroke", Root)
    rootStroke.Thickness = 1.2
    rootStroke.Color = C_BORDER

    local ViewportFrame = Instance.new("ViewportFrame")
    ViewportFrame.Size = UDim2.new(1, -16, 1, -16)
    ViewportFrame.Position = UDim2.new(0, 8, 0, 8)
    ViewportFrame.BackgroundColor3 = Color3.fromRGB(10, 10, 14)
    ViewportFrame.BorderSizePixel = 0
    ViewportFrame.Parent = Root
    Instance.new("UICorner", ViewportFrame).CornerRadius = UDim.new(0, 8)
    local vpStroke = Instance.new("UIStroke", ViewportFrame)
    vpStroke.Thickness = 1
    vpStroke.Color = Color3.fromRGB(30, 30, 38)

    local GridContainer = Instance.new("Frame")
    GridContainer.Size = UDim2.new(1, 0, 1, 0)
    GridContainer.BackgroundTransparency = 1
    GridContainer.ClipsDescendants = true
    GridContainer.Parent = ViewportFrame
    local gridSpacing = 24
    for x = gridSpacing, 320, gridSpacing do
        local vLine = Instance.new("Frame")
        vLine.Size = UDim2.new(0, 1, 1, 0)
        vLine.Position = UDim2.new(0, x, 0, 0)
        vLine.BackgroundColor3 = Color3.new(1,1,1)
        vLine.BackgroundTransparency = 0.96
        vLine.BorderSizePixel = 0
        vLine.Parent = GridContainer
    end
    for y = gridSpacing, 540, gridSpacing do
        local hLine = Instance.new("Frame")
        hLine.Size = UDim2.new(1, 0, 0, 1)
        hLine.Position = UDim2.new(0, 0, 0, y)
        hLine.BackgroundColor3 = Color3.new(1,1,1)
        hLine.BackgroundTransparency = 0.96
        hLine.BorderSizePixel = 0
        hLine.Parent = GridContainer
    end

    local WorldModel = Instance.new("WorldModel")
    WorldModel.Parent = ViewportFrame

    local model
    local ok = pcall(function()
        local objects = game:GetObjects("rbxassetid://90405905565781")
        if objects and #objects > 0 then model = objects[1] end
    end)

    if ok and model then
        model.Parent = WorldModel
        local centerCFrame, modelSize = model:GetBoundingBox()
        local modelRadius = math.max(modelSize.X, modelSize.Y, modelSize.Z) / 2
        local Camera = Instance.new("Camera")
        ViewportFrame.CurrentCamera = Camera
        Camera.Parent = ViewportFrame
        local Light = Instance.new("PointLight")
        Light.Color = Color3.fromRGB(255, 255, 255)
        Light.Brightness = 2
        Light.Range = modelRadius * 5
        Light.Parent = Camera
        local distance = math.clamp(modelRadius * 2.1, 2, 30)
        local angleX, angleY = 0, 0.15
        local isDragging = false
        local isHoveringViewport = false
        local lastMousePosition = Vector2.new()
        local autoRotate = true
        local lastInteractionTime = 0
        local AUTO_ROTATE_DELAY = 2.5

        local function onMouseWheelAction(_, _, _)
            if isHoveringViewport then return Enum.ContextActionResult.Sink end
            return Enum.ContextActionResult.Pass
        end
        ContextActionService:BindActionAtPriority(
            ACTION_NAME,
            onMouseWheelAction,
            false,
            Enum.ContextActionPriority.High.Value,
            Enum.UserInputType.MouseWheel
        )

        ViewportFrame.MouseEnter:Connect(function() isHoveringViewport = true end)
        ViewportFrame.MouseLeave:Connect(function()
            isHoveringViewport = false
            isDragging = false
        end)
        ViewportFrame.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                isDragging = true
                autoRotate = false
                lastMousePosition = input.Position
                lastInteractionTime = os.clock()
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                isDragging = false
                lastInteractionTime = os.clock()
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if isDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                local delta = input.Position - lastMousePosition
                lastMousePosition = input.Position
                angleX = angleX - delta.X * 0.008
                angleY = math.clamp(angleY - delta.Y * 0.008, -math.pi / 2.2, math.pi / 2.2)
                lastInteractionTime = os.clock()
            end
        end)
        ViewportFrame.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseWheel then
                distance = math.clamp(
                    distance - input.Position.Z * (modelRadius * 0.2),
                    modelRadius * 0.5,
                    modelRadius * 6
                )
            end
        end)
        RunService.RenderStepped:Connect(function(dt)
            if not isDragging and not autoRotate and (os.clock() - lastInteractionTime) > AUTO_ROTATE_DELAY then
                autoRotate = true
            end
            if autoRotate then angleX = angleX + dt * 0.5 end
            local focus = centerCFrame.Position
            local cf = CFrame.new(focus) * CFrame.Angles(0, angleX, 0) * CFrame.Angles(angleY, 0, 0) * CFrame.new(0, 0, distance)
            Camera.CFrame = CFrame.new(cf.Position, focus)
        end)
    else
        warn("[Thorium3DPreview] failed to load model")
    end

    Thorium3DPreview = Root

    RunService.RenderStepped:Connect(function()
        if not Thorium3DPreview or not MainFrame then return end
        local menuVisible = MainFrame.Visible and MainFrame.GroupTransparency < 1
        local onEspTab = (currentActiveTab == "ESP")
        if not menuVisible or not onEspTab then
            if Thorium3DPreview.Visible then Thorium3DPreview.Visible = false end
            return
        end
        local mp = MainFrame.AbsolutePosition
        local ms = MainFrame.AbsoluteSize
        if ms.X <= 0 or ms.Y <= 0 then return end
        Thorium3DPreview.Position = UDim2.new(0, mp.X + ms.X + GAP, 0, mp.Y)
        Thorium3DPreview.Size = UDim2.new(0, 320, 0, ms.Y)
        if not Thorium3DPreview.Visible then Thorium3DPreview.Visible = true end
    end)
end

