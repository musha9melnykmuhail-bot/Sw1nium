}
local _notifyCooldown = {}
local function ShowNotification(titleText, stateOrStyle)
    local key = tostring(titleText) .. "_" .. tostring(stateOrStyle)
    local now = os.clock()
    if _notifyCooldown[key] and (now - _notifyCooldown[key]) < 0.15 then return end
    _notifyCooldown[key] = now

    local styleName, statusSuffix = "Info", ""
    if type(stateOrStyle) == "boolean" then
        styleName = stateOrStyle and "Success" or "Danger"
        statusSuffix = stateOrStyle and " > ON" or " > OFF"
    elseif type(stateOrStyle) == "string" and NOTIFY_STYLES[stateOrStyle] then
        styleName = stateOrStyle
    end
    local style = NOTIFY_STYLES[styleName]

    local toast = Instance.new("CanvasGroup", NotifyContainer)
    toast.Size = UDim2.new(0, 210, 0, 36)
    toast.BackgroundColor3 = C_BG
    toast.BorderSizePixel = 0
    toast.GroupTransparency = 1
    toast.ClipsDescendants = true
    Instance.new("UICorner", toast).CornerRadius = UDim.new(0, 8)
    local tStroke = Instance.new("UIStroke", toast)
    tStroke.Thickness = 1
    tStroke.Color = C_BORDER

    local tShadow = Instance.new("ImageLabel", toast)
    tShadow.Size = UDim2.new(1, 30, 1, 30)
    tShadow.Position = UDim2.new(0, -15, 0, -15)
    tShadow.BackgroundTransparency = 1
    tShadow.ZIndex = 0
    tShadow.Image = "rbxassetid://1316045217"
    tShadow.ImageColor3 = Color3.new(0,0,0)
    tShadow.ImageTransparency = 0.5
    tShadow.ScaleType = Enum.ScaleType.Slice
    tShadow.SliceCenter = Rect.new(10, 10, 118, 118)

    local indicator = Instance.new("Frame", toast)
    indicator.Size = UDim2.new(0, 3, 1, 0)
    indicator.Position = UDim2.new(0, 0, 0, 0)
    indicator.BackgroundColor3 = style.Color
    indicator.ZIndex = 2
    Instance.new("UICorner", indicator).CornerRadius = UDim.new(0, 8)

    local iconLabel = Instance.new("ImageLabel", toast)
    iconLabel.Size = UDim2.new(0, 16, 0, 16)
    iconLabel.Position = UDim2.new(0, 12, 0.5, -8)
    iconLabel.BackgroundTransparency = 1
    iconLabel.Image = style.Icon
    iconLabel.ImageColor3 = style.Color
    iconLabel.ScaleType = Enum.ScaleType.Fit
    iconLabel.ZIndex = 2

    local txt = Instance.new("TextLabel", toast)
    txt.Size = UDim2.new(1, -44, 1, 0)
    txt.Position = UDim2.new(0, 36, 0, 0)
    txt.BackgroundTransparency = 1
    txt.Font = Enum.Font.BuilderSansMedium
    txt.Text = titleText .. statusSuffix
    txt.TextColor3 = Color3.fromRGB(240, 240, 245)
    txt.TextSize = 12
    txt.TextXAlignment = Enum.TextXAlignment.Left
    txt.ZIndex = 2

    TweenService:Create(toast, TweenInfo.new(0.4, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {
        GroupTransparency = 0,
        Size = UDim2.new(0, 240, 0, 42)
    }):Play()

    task.delay(2.5, function()
        if not toast.Parent then return end
        local tw = TweenService:Create(toast, TweenInfo.new(0.3, Enum.EasingStyle.Exponential, Enum.EasingDirection.In), {
            GroupTransparency = 1,
            Size = UDim2.new(0, 210, 0, 36)
        })
        tw:Play()
        tw.Completed:Connect(function() toast:Destroy() end)
    end)
end

