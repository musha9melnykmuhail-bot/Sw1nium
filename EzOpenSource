        M.bunnyhop = s
        if not s and M._bhopConn then M._bhopConn:Disconnect(); M._bhopConn = nil end
        if s then
            M._bhopConn = RunService.Heartbeat:Connect(function()
                if not M.bunnyhop then return end
                local hum = GetHumanoid()
                if hum and hum.MoveDirection.Magnitude > 0.1 then
                    pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
                end
            end)
        end
    end, "Movement")
    F.CreateCheck(cardJump, "Noclip", false, function(s)
        M.noclip = s
        if not s and M._noclipConn then M._noclipConn:Disconnect(); M._noclipConn = nil end
        if s then
            M._noclipConn = RunService.Stepped:Connect(function()
                if not M.noclip then return end
                local c = LocalPlayer.Character
                if c then
                    for _, p in ipairs(c:GetDescendants()) do
                        if p:IsA("BasePart") and p.CanCollide then p.CanCollide = false end
                    end
                end
            end)
        end
    end, "Movement")

